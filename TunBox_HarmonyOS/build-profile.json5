{
  "app": {
    // 命令行 hvigor 无法使用 DevEco 加密密码串，signingConfigs 保持空（产 unsigned 包），
    // 签名一律走仓库根 sign-nexus-package.ps1（材料在 AGC通用证书目录，不入库）。
    //
    // ⚠ 本文件被 git 跟踪，**永远不要提交 signingConfigs**（2026-10-19 复盘）：
    //   0.4.0 曾把本机 DevEco 调试证书路径 + 加密口令串提交进 main，导致
    //   ①换机/CI 构建直接失败或签名不匹配；②凭据类材料入库；③与文件内注释矛盾。
    //   DevEco「自动生成签名」写进来的 signingConfigs 只允许留在本地工作区，
    //   提交前必须恢复为空数组（scripts/verify-build-profile.mjs 会拦截）。
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        // SDK 基线：本机 SDK 为 HarmonyOS 6.1.1（API 24）；产物可向后兼容安装到 API 26 设备
        "compatibleSdkVersion": "6.1.1(24)",
        // 沉浸光感官方硬性要求 targetSDKVersion >= 26.0.0（《开启沉浸光感》：
        // 「开启沉浸光感，要确保应用的targetSDKVersion不低于26.0.0」）。
        // 本机 SDK 为 HarmonyOS 26.0.0(105)，compatibleSdkVersion 保持 6.1.1(24) 向下兼容。
        "targetSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS"
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
