{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": ["phone", "tablet"],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    // 沉浸光感应用级开关（官方《开启沉浸光感》）：enable 模式下 Toast、Menu、
    // Dialog（AlertDialog/promptAction 弹窗/CustomDialog/半模态）、Toggle、Slider、
    // Select 下拉按钮与下拉菜单、AlphabetIndexer 提示弹窗默认开启沉浸光感；
    // Navigation 标题栏（返回键/非自定义 Menu）同样默认生效。
    // 组件级配置优先级高于本开关；该配置仅在 entry 类型 module 中生效。
    "metadata": [
      { "name": "ohos.arkui.UIMaterial.state", "value": "enable" }
    ],
    "requestPermissions": [
      { "name": "ohos.permission.INTERNET" },
      { "name": "ohos.permission.GET_NETWORK_INFO" },
      // 启动按钮按下触觉反馈（CelestialPowerOrb）：system_grant 普通权限，安装即授予
      { "name": "ohos.permission.VIBRATE" },
      { "name": "ohos.permission.KEEP_BACKGROUND_RUNNING", "reason": "$string:bg_task_reason", "usedScene": { "abilities": ["EntryAbility", "VpnExtensionAbility"], "when": "inuse" } }
      // 权限最小化（2026-10-07 评审）：GET_BUNDLE_INFO 已移除 —— 唯一消费方 AppInfo 使用
      // bundleManager.getBundleInfoForSelfSync 读取自身版本号（官方未标注需要权限，官方示例均不声明）。
      // 权限红线（安装 ACL 校验会失败的受限权限，一律不得声明）：
      //   ohos.permission.MANAGE_VPN / NOTIFICATION_CONTROLLER / START_ABILITIES_FROM_BACKGROUND
      // HarmonyOS 6.x 上 type:"vpn" 的 VpnExtensionAbility 无需上述权限即可安装运行，
      // 运行时由系统 VPN 授权弹框管控（同 Android）。参照 NekoBox4Harmony 已验证做法。
      // 自己应用的通知用 notificationManager.publish 即可，不需要 NOTIFICATION_CONTROLLER。
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:ability_desc",
        "icon": "$media:layered_image",
        "label": "$string:app_name",
        "startWindowIcon": "$media:start_icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        // App 内手动连接路径的会话守护：连接成功后注册长时任务，
        // 防止 UI 进程退后台被杀连带回收 VpnExtensionAbility（真机取证 2026-09-24）。
        //
        // 2026-10-20：类型由 ["dataTransfer"] 扩为 ["dataTransfer", "taskKeeping"]。
        //  · taskKeeping：VPN 隧道保活的**正确**类型（官方长时任务类型表：
        //    DATA_TRANSFER =「非托管形式的上传、下载」；TASK_KEEPING =「计算任务」，
        //    场景举例杀毒软件）。用 dataTransfer 会被系统按
        //    ContinuousTaskCancelReason.SYSTEM_CANCEL_DATA_TRANSFER_LOW_SPEED(4) /
        //    ContinuousTaskSuspendReason.SYSTEM_SUSPEND_DATA_TRANSFER_LOW_SPEED(4)
        //    取消或暂停长时任务 → 全应用失去「所有进程不被挂起」的保护。
        //  · dataTransfer：**回退类型**。taskKeeping 在非 PC/2-in-1 设备上需要受限
        //    权限 ohos.permission.KEEP_BACKGROUND_RUNNING_SYSTEM（SDK
        //    BackgroundTaskMode 注释原文），未获授权时由 UiGuardian.applyContinuousTask
        //    自动回退，行为与改造前完全一致。
        //  · 两种都声明：运行时才能按实际可用性选择；声明未申请的 bgMode 会在
        //    申请时被系统以 9800001（bgMode 无效）拒绝。
        //
        // ⚠ 一旦在 AGC 拿到 ohos.permission.KEEP_BACKGROUND_RUNNING_SYSTEM
        //   （system_basic 级受限权限，API 12 起向普通应用开放、API 26.0.0 起支持
        //   全设备申请，需审批并提交承诺书），**还要**把该权限加进上面的
        //   requestPermissions 数组；在此之前**不得**声明 —— 未获审批即声明受限
        //   权限会导致安装期 ACL 校验失败（装不上）。加了权限后两种模式仍都能工作
        //   （申请失败会自动回退）。
        "backgroundModes": ["dataTransfer", "taskKeeping", "audioPlayback"],
        "skills": [
          {
            "entities": ["entity.system.home"],
            "actions": ["action.system.home"]
          },
          {
            // tunbox:// scheme（P1-3c）：一键导入订阅，如 tunbox://import?url=<encoded-sub-url>
            "actions": ["ohos.want.action.viewData"],
            "uris": [{ "scheme": "tunbox" }]
          }
        ]
      },
      // 桌面「启动代理」快捷方式已按用户要求下线（2026-09-10）。
      // QuickToggleAbility.ets 与 VpnQuickStart.ets 源码保留但不再声明，
      // 需要时重新加入本数组并在 resources/base/profile 恢复 shortcuts_config.json 即可。
      {
        // 长按图标「启动代理」与服务卡片点击的共同目标: 无界面宿主, 后台拨 VPN;
        // 连接成功后转为会话守护者(注册 dataTransfer 连续任务), 断开时才自毁, 不进 App
        "name": "QuickToggleAbility",
        "srcEntry": "./ets/quicktoggleability/QuickToggleAbility.ets",
        "description": "$string:ability_desc",
        "icon": "$media:layered_image",
        "label": "$string:app_name",
        "startWindowIcon": "$media:start_icon",
        "startWindowBackground": "$color:start_window_background",
        "launchType": "singleton",
        "removeMissionAfterTerminate": true,
        // 连续任务只能在 UIAbility 上下文注册（扩展进程内必然 401，真机实证）；
        // 守护 :vpn 会话存活期间本能力保持驻留。
        // 类型说明同 EntryAbility：taskKeeping 为首选（隧道保活的正确类型），
        // dataTransfer 为未获 ohos.permission.KEEP_BACKGROUND_RUNNING_SYSTEM
        // 受限权限时的回退类型；两种都声明，运行时才能按实际可用性选择。
        "backgroundModes": ["dataTransfer", "taskKeeping", "audioPlayback"],
        "exported": false
      }
    ],
    "extensionAbilities": [
      {
        "name": "VpnExtensionAbility",
        "srcEntry": "./ets/vpnability/VpnExtensionAbility.ets",
        "type": "vpn",
        "description": "$string:vpn_desc",
        "exported": false
      },
      {
        "name": "EntryFormAbility",
        "srcEntry": "./ets/entryformability/EntryFormAbility.ets",
        "type": "form",
        "description": "$string:form_desc",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.form",
            "resource": "$profile:form_config"
          }
        ]
      },
      {
        // 订阅自动刷新的延迟任务扩展（WorkSchedulerExtensionAbility）：
        // 系统按内存/功耗统一调度拉起（约 4h 轮询），到期只刷新过期的订阅。
        // 调度逻辑全在 SubscriptionUpdateScheduler，本扩展只是触发点。
        "name": "SubscriptionWorkAbility",
        "srcEntry": "./ets/workscheduler/SubscriptionWorkAbility.ets",
        "type": "workScheduler",
        "description": "$string:work_desc",
        "exported": false
      }
    ]
  }
}
