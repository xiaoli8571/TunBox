# ---- DevEco / OpenHarmony build outputs ----
build/
.hvigor/
.cxx/
.preview/
oh_modules/
entry/oh_modules/
**/oh_modules/
entry/build/
**/build/
*.hap
*.hap.gz
*.app
# 但 *.app 在大小写不敏感的 Windows 上会顺手把 Windows 端源码目录 TunBox.App 整个判为忽略，
# 那里新增的 .cs/.xaml 会静默进不了仓库（tracked 文件不受影响，所以一直没人发现）。显式豁免它。
!TunBox-Windows/src/TunBox.App/
!TunBox-Windows/src/TunBox.App/**
*.log
*.json.gz
oh-package-lock.json5

# ---- IDE ----
.idea/
.vscode/
*.iml

# ---- signing materials (NEVER commit) ----
*.p12
*.keystore
*.jks
*.cer
*.p7b

# ---- OS junk ----
Thumbs.db
Desktop.ini
.DS_Store

# ---- core build logs ----
ssrvpn_go_build_*.log

# ---- kernel build artifacts (downloaded, not source) ----
# mihomo.exe 已被 mihomo-build/*/.gitignore 覆盖；这里补 Model.bin（LightGBM 模型，
# 9.3MB，由 verify-smart-e2e.mjs 使用；绝不入库）。
mihomo-build/Model.bin

# keep prebuilt core library (enables clone-and-build without the Go toolchain)
!entry/libs/**

# ---- signing material & IDE native-assistant files (NEVER commit) ----
material/
*.csr
.clangd
.clang-tidy

# ---- SSRVPN security: snapshots / patches / build logs / temp artifacts ----
# These dirs/files historically carried plaintext signing passwords.
SSRVPN_HarmonyOS-*-Rollback-*/
SSRVPN_HarmonyOS-*-Snapshot-*/
SSRVPN_HarmonyOS-*-Upgrade/
SSRVPN_HarmonyOS-before-fix-*.patch
*-Rollback-*/
*-Snapshot-*/
*-Backup-*/
*.patch
*.diff
*.log
*.dmp
hs_err_pid*.log
replay_pid*.log
b_err*.txt
b_out*.txt
bc.err
*.tmp
*.bak
*.orig
*.rej
.env
.env.*
*secret*
*credential*
*passwd*
*password*

# ---- local MCP configuration (contains credentials; NEVER commit) ----
.mcp.json
# Agent skills 里存着 GitHub 令牌与签名口令（AGENTS.md 约定永不入库）。
# 它们物理上在本目录树内，只靠「白名单 git add」兜着，这里补一道 ignore 防误提交。
skills/
# Agent/IDE 会话状态目录，散落在多层（含 entry/src 下），会被白名单 add 扫到
.mimosa/
_audit/
SSRVPN_HarmonyOS/tools/true-parser-harness/YamlMerger.ts
SSRVPN_HarmonyOS/tools/true-parser-harness/YamlMerger.head.ets
SSRVPN_HarmonyOS/tools/true-parser-harness/evidence-*.txt
SSRVPN_HarmonyOS/tools/true-chain-harness/generated/
SSRVPN_HarmonyOS/tools/true-parser-harness/*.ts

# 例外：应用源码（不含任何凭据材料），Windows core.ignorecase 下被 *credential* 误捕而从未入库
!TunBox_HarmonyOS/entry/src/main/ets/commons/services/CredentialStore.ets
